{
  "name": "clover-mail",
  "version": "0.4.69",
  "description": "Clover Mail - a fast, good-looking email client with live wallpapers, custom apps, calendar/ICS, and AI copilot.",
  "author": "CLOVERFIELD FARMS IT SERVICES",
  "license": "MIT",
  "private": true,
  "desktopName": "com.clovermail.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/khaelec/clover-mail.git"
  },
  "homepage": "https://github.com/khaelec/clover-mail",
  "bugs": {
    "url": "https://github.com/khaelec/clover-mail/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "db:generate": "drizzle-kit generate",
    "licenses": "node scripts/generate-licenses.cjs",
    "test:ipc": "node scripts/check-ipc.cjs",
    "test:reconcile": "tsx scripts/reconcile-smoke.ts",
    "test:announce": "tsx scripts/announce-smoke.ts",
    "test:attach": "tsx scripts/attachments-clean-smoke.ts",
    "test:transport": "tsx scripts/transport-smoke.ts",
    "test:notifications": "tsx scripts/notifications-smoke.ts",
    "test:imap": "electron scripts/imap-integration.cjs",
    "test:imap-timeout": "tsx scripts/imap-timeout-smoke.ts",
    "bench:build": "node scripts/bench-build.cjs",
    "bench:seed": "electron scripts/bench-seed.cjs",
    "bench:list": "electron scripts/bench-list.cjs",
    "test:smoke": "electron-vite build && electron scripts/electron-integration.cjs && electron scripts/pop3-integration.cjs && electron scripts/api-smoke.cjs && electron scripts/bell-layering.cjs && npm run test:reconcile && npm run test:announce && npm run test:attach && npm run test:transport && npm run test:notifications && npm run test:imap-timeout",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:personal": "electron-vite build && electron-builder --win --config electron-builder.personal.yml --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "harper.js": "^2.10.0",
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
